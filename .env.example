# 秘密ファイルは npm run setup で生成します。パスワードをここに書かないでください。
FRONTEND_PORT=5173
BACKEND_PORT=3000

# DB管理者とアプリ用ユーザーを分離します。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=keibi
POSTGRES_USER=keibi
POSTGRES_APP_USER=keibi_app
POSTGRES_APP_PASSWORD_FILE=.secrets/postgres_app_password
POSTGRES_ADMIN_PASSWORD_FILE=.secrets/postgres_admin_password

# Google OAuth クライアント秘密はファイルだけに保存します。
# callback URL を Google Cloud に完全一致で登録してください。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_FILE=.secrets/google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
APP_ORIGIN=http://localhost:5173

# 本人Googleメールへの招待用SMTP。秘密はファイルだけに保存します。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD_FILE=.secrets/smtp_password
SMTP_FROM=

# Originは完全一致で判定します。FRONTEND_PORTを変更した場合はこちらも変更してください。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION=60
MAX_BODY_BYTES=1048576

# Docker Desktop / WSL2向けのファイル監視。
CHOKIDAR_USEPOLLING=true
