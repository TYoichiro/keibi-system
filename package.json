{
  "name": "keibi-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "docker compose up --build",
    "dev:frontend": "npm run dev --workspace @keibi/frontend",
    "dev:backend": "npm run dev --workspace @keibi/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --project tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test.mjs --e2e",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs",
    "auth:operator": "npm run operator --workspace @keibi/backend --",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
