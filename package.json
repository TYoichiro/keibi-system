{
  "name": "keibi-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/frontend", "apps/backend"],
  "engines": { "node": ">=24 <25", "npm": ">=11" },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "docker compose up --build",
    "dev:frontend": "npm run dev --workspace @keibi/frontend",
    "dev:backend": "npm run dev --workspace @keibi/backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspace @keibi/backend",
    "security:audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
